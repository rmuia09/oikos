{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd gatsby && npm ci",
  "buildCommand": "cd gatsby && npm run build",
  "outputDirectory": "gatsby/public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
